#include <stdlib.h>

#include "sleep.h"
#include "vdma_api.h"
#include "xparameters.h"
#include "xil_cache.h"
#include "xgpio.h"
#include "clk_wiz.h"
#include "./display_ctrl/display_ctrl.h"

#define AXI_GPIO_CHANNEL1	1

#define AXI_VDMA_DEVICE_ID 	XPAR_AXI_VDMA_0_DEVICE_ID
#define LCD_WIDTH 			800							//lcd屏幕的宽度
#define LCD_HEIGHT 			480							//lcd屏幕的高度
#define LCD_PIXEL_CHANNELS	3							//lcd通道数量

//产生彩条数据
static void MakeColorBar(u8* _pStartBuf, int _Width, int _Height)
{
	int i, j;
	// 彩虹色条数量：7色（红、橙、黄、绿、青、蓝、紫）
	const int COLOR_COUNT = 7;
	// 每个颜色占据的像素宽度
	int nBarWidth = _Width * LCD_PIXEL_CHANNELS / COLOR_COUNT;

	for(i = 0; i < _Height; i++)
	{
		for(j = 0; j < _Width * LCD_PIXEL_CHANNELS; j+=3)
		{
			// 计算当前像素属于第几个颜色条
			int nColorIndex = j / nBarWidth;
			// 计算当前像素在缓冲区的起始索引（BGR格式）
			int nBufIndex = i * LCD_PIXEL_CHANNELS + j;

			u8 r, g, b;
			// 彩虹7色：BGR分量定义
			switch(nColorIndex)
			{
				case 0: // 红色
					r = 255; g = 0;   b = 0;
					break;
				case 1: // 橙色
					r = 255; g = 127; b = 0;
					break;
				case 2: // 黄色
					r = 255; g = 255; b = 0;
					break;
				case 3: // 绿色
					r = 0;   g = 255; b = 0;
					break;
				case 4: // 青色
					r = 0;   g = 255; b = 255;
					break;
				case 5: // 蓝色
					r = 0;   g = 0;   b = 255;
					break;
				case 6: // 紫色
					r = 255; g = 0;   b = 255;
					break;
				default:// 超出部分默认白色
					r = 255; g = 255; b = 255;
					break;
			}

			// 写入像素数据（BGR通道顺序，和原代码一致）
			_pStartBuf[nBufIndex + 0] = b;  // B分量
			_pStartBuf[nBufIndex + 1] = g;  // G分量
			_pStartBuf[nBufIndex + 2] = r;  // R分量
		}
	}

	Xil_DCacheFlush();
}

int main()
{
	XAxiVdma InstancePtr;
	XGpio_Config* ptXGpio_Config = NULL;
	XGpio tXGpio = { 0 };
	s32 nStatus = 0;
	u32 unLCD_ID = 0;
	VideoMode tVideoMode = { 0 };

	xil_printf("\n--- Entering main() --- \r\n");

	u8* puchBuf = (u8*)malloc(LCD_WIDTH * LCD_PIXEL_CHANNELS * LCD_HEIGHT);
	if(!puchBuf)
	{
		xil_printf("malloc is err\r\n");
		return -1;
	}

	//根据器件ID查找器件的配置信息
	ptXGpio_Config = XGpio_LookupConfig(XPAR_GPIO_0_DEVICE_ID);

	//对GPIO的驱动配置进行初始化
	nStatus = XGpio_CfgInitialize(&tXGpio, ptXGpio_Config, ptXGpio_Config->BaseAddress);
	if (nStatus != XST_SUCCESS)
	{
		xil_printf("XGpio_CfgInitialize is failed\n\r");
		return 0;
	}

	//设置axi gpio按键为输入，可以不用设置，其实在vivado工程中asi_gpio_ip核中已经默认配置为输入
	XGpio_SetDataDirection(&tXGpio, AXI_GPIO_CHANNEL1, 0x7);

	unLCD_ID = LTDC_PanelID_Read(&tXGpio, AXI_GPIO_CHANNEL1);

	XGpio_SetDataDirection(&tXGpio, AXI_GPIO_CHANNEL1, 0);		//设置axi gpio按键为输出

	switch(unLCD_ID)			//根据lcd的id，选择lcd对应的时钟频率
	{
	case 0x4342:				//4.3寸屏,480*272分辨率
		tVideoMode;
		break;
	case 0x7084:				//7寸屏,800*480分辨率
		dbLCD_Freq = 33.3;
		break;
	case 0x7016:				//7寸屏,1024*600分辨率
		dbLCD_Freq = 50;
		break;
	case 0x4384:				//4.3寸屏,800*480分辨率
		dbLCD_Freq = 70;
		break;
	case 0x1018:				//10.1寸屏,1280*800分辨率
		dbLCD_Freq = 33.3;
		break;
	default:
		xil_printf("lcd type not support\n\r");
		break;
	}

	Clk_Wiz_Config(XPAR_CLK_WIZ_0_DEVICE_ID, dbLCD_Freq);

	//配置和开始vdma数据传输
	run_vdma_frame_buffer(
			&InstancePtr,					//vmda
			AXI_VDMA_DEVICE_ID,				//vdma设备id
			LCD_WIDTH,						//lcd屏宽度
			LCD_HEIGHT,						//lcd屏高度
			(int)puchBuf,					//ddr起始地址
			0,
			0,								//不使能中断
			ONLY_READ						//vdma读写通道选择，只使能读通道
			);

	MakeColorBar(puchBuf, LCD_WIDTH, LCD_HEIGHT);

	xil_printf("VDMA data transmit is success\n\r");

	while(1)
	{
		sleep(1);
	};

	if(puchBuf)
	{
		free(puchBuf);
		puchBuf = NULL;
	}

	return 0;
}
