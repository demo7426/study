#include <stdlib.h>

#include "clk_wiz.h"
#include "xclk_wiz.h"
#include "xparameters.h"

#define CLK_WIZ_IN_FREQ		100			//时钟ip核输入100MHz

#define CLK_SR_OFFSET 		0x4			//status register
#define CLK_CFG0_OFFSET 	0x200		//clock configuration register 0
#define CLK_CFG2_OFFSET 	0x208		//clock configuration register 2
#define CLK_CFG23_OFFSET 	0x25C		//clock configuration register 23

int Clk_Wiz_Config(int _ClkDevID, double _Freq)
{
	int nRtn = 0;
	doubel dbDivFactor = 0;		//分频系数
	u32 unDivFactor_Int = 0;	//分频系数整数部分
	u32 unDivFactor_Frac = 0;	//分频系数小数部分
	u32 unClkDivide = 0;

	XClk_Wiz tXClk_Wiz;

	XClk_Wiz_Config * ptXClk_Wiz_Config = XClk_Wiz_LookupConfig(_ClkDevID);
	if(!ptXClk_Wiz_Config)
	{
		printf("XClk_Wiz_LookupConfig is err\r\n");
		return -2;
	}

	nRtn = XClk_Wiz_CfgInitialize(&tXClk_Wiz, ptXClk_Wiz_Config, ptXClk_Wiz_Config->BaseAddr);
	if(nRtn != XST_SUCCESS)
	{
		printf("XClk_Wiz_CfgInitialize is err\r\n");
		return -2;
	}

	//配置时钟倍频/分频系数，10倍频，1分频
	XClk_Wiz_WriteReg(ptXClk_Wiz_Config->BaseAddr, CLK_CFG0_OFFSET, 0x0a01);

	//计算分频系数
	dbDivFactor = CLK_WIZ_IN_FREQ * 10 / _Freq;
	unDivFactor_Int = (u32)dbDivFactor;
	unDivFactor_Frac = (u32)(dbDivFactor - unDivFactor_Int) * 1000;
	unClkDivide = unDivFactor_Int | (unDivFactor_Frac << 8);
	XClk_Wiz_WriteReg(ptXClk_Wiz_Config->BaseAddr, CLK_CFG2_OFFSET, unClkDivide);

	//加载重配置的参数
	XClk_Wiz_WriteReg(ptXClk_Wiz_Config->BaseAddr, CLK_CFG23_OFFSET, 0x3);

	while(1)
	{
		XClk_Wiz_ReadReg(ptXClk_Wiz_Config->BaseAddr, CLK_SR_OFFSET)
	}
}


