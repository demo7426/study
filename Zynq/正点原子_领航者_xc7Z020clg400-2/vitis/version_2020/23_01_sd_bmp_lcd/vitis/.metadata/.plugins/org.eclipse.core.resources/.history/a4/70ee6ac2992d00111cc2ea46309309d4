#include <stdlib.h>

#include "sleep.h"
#include "./vdma_api/vdma_api.h"
#include "xparameters.h"
#include "xil_cache.h"
#include "xgpio.h"
#include "./clk_wiz/clk_wiz.h"
#include "./display_ctrl/display_ctrl.h"
#include "ff.h"

#define AXI_GPIO_CHANNEL1	1

#define AXI_VDMA_DEVICE_ID 	XPAR_AXI_VDMA_0_DEVICE_ID
#define LCD_WIDTH 			800							//lcd屏幕的宽度
#define LCD_HEIGHT 			480							//lcd屏幕的高度
#define LCD_PIXEL_CHANNELS	3							//lcd通道数量

//挂载SD卡
static int Mount_SD(FATFS *_pFatFS, const char* _pPath)
{
	if(!_pFatFS || !_pPath)
	{
		xil_printf("%s: input param is err.\r\n", __FUNCTION__);
		return -1;
	}

	FRESULT eRes = FR_OK;

	//立即挂载
	eRes = f_mount(_pFatFS, _pPath, 1);
	if(eRes != FR_OK)
	{
		//挂载失败，格式设备，重新挂载
		eRes = f_mkfs(_pPath, FM_FAT32, 0, g_uchWork, sizeof(g_uchWork));
		if(eRes != FR_OK)
		{
			xil_printf("%s: f_mkfs is failed.\r\n", __FUNCTION__);
			return -2;
		}

		//重新挂载设备
		eRes = f_mount(_pFatFS, _pPath, 1);
		if(eRes != FR_OK)
		{
			xil_printf("%s: f_mount is failed.\r\n", __FUNCTION__);
			return -2;
		}
	}

	return 0;
}

//加载bmp文件数据
static void LoadBMPFileData(const char* _pFilePath, u8* _pStartBuf, int _Len)
{
	FATFS tFatFS = { 0 };
	const char* pchPath = "0:";
	const char* pchFilePath = "0:micro_sd_rw_test.txt";

	char chBMPFileHeader[54] = { 0 };		//bmp文件头

	//挂载设备
	Mount_SD(&tFatFS, pchPath);

	FIL tFIL;
	FRESULT eRes = FR_OK;
	int nSucReadLen = 0;		//成功读取的字节数

	eRes = f_open(&tFIL, _pFilePath, FA_WRITE | FA_CREATE_ALWAYS);
	if(eRes != FR_OK)
	{
		xil_printf("%s: f_open is failed.\r\n", __FUNCTION__);
		return -2;
	}

	f_read(&tFIL, chBMPFileHeader, 54, (UINT*)&nSucReadLen);				//读取出bmp文件头


	eRes = f_read(&tFIL, _pStartBuf, _Len, (UINT*)&nSucReadLen);
	if(eRes != FR_OK)
	{
		xil_printf("%s: f_write is failed.\r\n", __FUNCTION__);
		return -2;
	}
	else
	{
		xil_printf("%s: f_read data len is %d\r\n", __FUNCTION__, nSucReadLen);
	}

	f_close(&tFIL);

	Xil_DCacheFlush();
}

int main()
{
	XAxiVdma InstancePtr;
	XGpio_Config* ptXGpio_Config = NULL;
	XGpio tXGpio = { 0 };
	s32 nStatus = 0;
	u32 unLCD_ID = 0;
	VideoMode tVideoMode = { 0 };

	DisplayCtrl tDisplayCtrl = { 0 };

	xil_printf("\n--- Entering main() --- \r\n");

	u8* puchBuf = (u8*)malloc(LCD_WIDTH * LCD_PIXEL_CHANNELS * LCD_HEIGHT);
	if(!puchBuf)
	{
		xil_printf("malloc is err\r\n");
		return -1;
	}

	//根据器件ID查找器件的配置信息
	ptXGpio_Config = XGpio_LookupConfig(XPAR_GPIO_0_DEVICE_ID);

	//对GPIO的驱动配置进行初始化
	nStatus = XGpio_CfgInitialize(&tXGpio, ptXGpio_Config, ptXGpio_Config->BaseAddress);
	if (nStatus != XST_SUCCESS)
	{
		xil_printf("XGpio_CfgInitialize is failed\n\r");
		return 0;
	}

	//设置axi gpio按键为输入，可以不用设置，其实在vivado工程中asi_gpio_ip核中已经默认配置为输入
	XGpio_SetDataDirection(&tXGpio, AXI_GPIO_CHANNEL1, 0x7);

	unLCD_ID = LTDC_PanelID_Read(&tXGpio, AXI_GPIO_CHANNEL1);

	XGpio_SetDataDirection(&tXGpio, AXI_GPIO_CHANNEL1, 0);		//设置axi gpio按键为输出

	switch(unLCD_ID)			//根据lcd的id，选择lcd对应的时钟频率
	{
	case 0x4342:				//4.3寸屏,480*272分辨率
		tVideoMode = VMODE_480x272;
		break;
	case 0x7084:				//7寸屏,800*480分辨率
		tVideoMode = VMODE_800x480;
		break;
	case 0x7016:				//7寸屏,1024*600分辨率
		tVideoMode = VMODE_1024x600;
		break;
	case 0x4384:				//4.3寸屏,800*480分辨率
		tVideoMode = VMODE_800x480;
		break;
	case 0x1018:				//10.1寸屏,1280*800分辨率
		tVideoMode = VMODE_1280x800;
		break;
	default:
		xil_printf("lcd type not support\n\r");
		break;
	}

	//设置时钟ip和输出的时钟频率
	Clk_Wiz_Config(XPAR_CLK_WIZ_0_DEVICE_ID, tVideoMode.freq);

	//初始化display controler
	DisplayInitialize(&tDisplayCtrl, XPAR_VTC_0_DEVICE_ID);

	//设置video model
	DisplaySetMode(&tDisplayCtrl, &tVideoMode);
	DisplayStart(&tDisplayCtrl);

	LoadBMPFileData(puchBuf, LCD_WIDTH, LCD_HEIGHT);

	//配置和开始vdma数据传输
	run_vdma_frame_buffer(
			&InstancePtr,					//vmda
			AXI_VDMA_DEVICE_ID,				//vdma设备id
			LCD_WIDTH,						//lcd屏宽度
			LCD_HEIGHT,						//lcd屏高度
			(int)puchBuf,					//ddr起始地址
			0,
			0,								//不使能中断
			ONLY_READ						//vdma读写通道选择，只使能读通道
			);

	xil_printf("VDMA data transmit is success\n\r");

	while(1)
	{
		sleep(10);
	};

	if(puchBuf)
	{
		free(puchBuf);
		puchBuf = NULL;
	}

	return 0;
}
